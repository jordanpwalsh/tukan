    },
    "481f9cd6-a407-4ce8-9498-79700fa91f14": {
      "id": "481f9cd6-a407-4ce8-9498-79700fa91f14",
      "name": "Emit idle event in --wait --json stream",
      "description": "When the pane hasn't changed for N seconds, emit a {type:'idle'} NDJSON event in the --wait --json stream. The consumer (sub-agent) can then peek and decide what the idle state means — plan approval, stuck script, finished, etc. Tukan stays agnostic about pane content.\n\nDesign decisions:\n- Idle timeout is a global config value (default 3s), not a per-command flag\n- Idle event re-fires repeatedly while the pane stays idle (so sub-agents don't miss it)\n- Any new snapshot (pane activity) resets the idle timer\n\nEvent shape: {type:'idle', cardId:'...', windowId:'@0', idleMs: <ms since last change>, timestamp: ...}",
      "acceptanceCriteria": "idle event fires after 3s no-change (configurable globally); re-fires while pane stays idle; resets on any new snapshot; includes idleMs and timestamp; sub-agents can use it as a peek trigger without polling",
      "columnId": "4",
      "sessionName": "tukan",
      "dir": "/Users/jordan/devel/personal/tukan",
      "command": "claude",
      "worktree": false,
      "createdAt": 1771483157225,
      "startedAt": 1771483833104,
      "closedAt": 1771484247713
    },
    "6c5abbe7-34b4-4c33-a693-0d1536d4c5d5": {
      "id": "6c5abbe7-34b4-4c33-a693-0d1536d4c5d5",
      "name": "Reusable card watcher sub-agent template",
      "description": "Build a standardized sub-agent prompt/pattern that: runs tukan start <id> --wait --json, watches the stream for idle/closed events, peeks at pane content when idle to decide next action (auto-approve safe Claude Code permissions, surface plan approval to Telegram, etc.), and sends a final summary when the card closes. Lives in the tukan skill, not in tukan itself — each command type (claude, shell, codex) may need its own watcher variant.",
      "acceptanceCriteria": "Starting a card from Telegram spawns a watcher sub-agent; Jordan gets notified on idle (needs input) and on close (done); watcher handles common Claude Code prompts automatically",
      "columnId": "4",
      "sessionName": "tukan",
      "dir": "/Users/jordan/.openclaw/skills/tukan",
      "command": "claude",
      "worktree": false,
      "createdAt": 1771483164053,
      "startedAt": 1771524215364,
      "closedAt": 1771526705755
    },
    "d2b79120-5668-484a-8f01-c69859454dd7": {
      "id": "d2b79120-5668-484a-8f01-c69859454dd7",
      "name": "Conversation -> card spec -> Telegram approval flow",
      "description": "When Jordan describes a task, draft a structured card spec (name, description, AC, dir, session, command) and present it as a Telegram message with inline buttons: [✅ Start it] [✏️ Edit] [❌ Cancel]. On approval: create card, start it, spawn the watcher sub-agent. This is an orchestration pattern in the tukan skill — no tukan binary changes needed.",
      "acceptanceCriteria": "Jordan says 'build X', gets a card spec to approve via Telegram buttons, taps Start, gets one confirmation message, gets pinged when done or when input is needed",
      "columnId": "1",
      "sessionName": "tukan",
      "dir": "/Users/jordan/.openclaw/skills/tukan",
      "command": "claude",
      "worktree": false,
      "createdAt": 1771483170645
    },
    "2343dbc7-8812-444d-b303-f7a56978297f": {
      "id": "2343dbc7-8812-444d-b303-f7a56978297f",
      "name": "Store cards in project working directory (.tukan.cards)",
      "description": "Store card data in the working directory of the repo the card belongs to (e.g. a .tukan.cards file in the project root), rather than in ~/.config/tukan/sessions/. The ~/.config/tukan/ folder keeps a registry of known project directories so tukan can locate and query cards for any registered project even when not currently cd'd into it.",
      "acceptanceCriteria": "1. Cards for a session/project are stored in <project-dir>/.tukan.cards (or similar local file). 2. ~/.config/tukan/ maintains a registry mapping session names to their project directories. 3. tukan list, add, start, resolve all work correctly from any cwd by consulting the registry. 4. CLI command to register a project dir (e.g. tukan register <path> or auto-register on first use). 5. .tukan.cards is git-committable — card data travels with the repo. 6. Graceful fallback: if no local .tukan.cards exists, treat as empty board. 7. One-time migration script that reads existing ~/.config/tukan/sessions/*.json files, looks up each session's project dir from card data, and writes the cards out to the correct .tukan.cards files in each project directory.",
      "columnId": "4",
      "sessionName": "tukan",
      "dir": "/Users/jordan/devel/personal/tukan",
      "command": "claude",
      "worktree": false,
      "createdAt": 1771703534724,
      "startedAt": 1771707359312,
      "closedAt": 1771712644625
    },
