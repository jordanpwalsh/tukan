      "id": "68e2d127-b348-4663-bc63-04960f8be2e1",
      "name": "Add --json flag support",
      "description": "Add --json output flag to tukan commands (e.g. list, show) for machine-readable output. Motivated by the fact that 'tukan show' is TUI-only and requires raw mode — non-TTY contexts (like AI agents or scripts) have no way to read card details without parsing the session JSON directly.",
      "acceptanceCriteria": "--json flag works on relevant commands and outputs valid JSON",
      "columnId": "4",
      "sessionName": "tukan",
      "dir": "/Users/jordan/devel/personal/tukan",
      "command": "shell",
      "worktree": false,
      "createdAt": 1771309075685,
      "startedAt": 1771464723739,
      "closedAt": 1771464785066
    },
    "cfb5abd7-63cf-4fe9-9a09-1c13babe0d5b": {
      "id": "cfb5abd7-63cf-4fe9-9a09-1c13babe0d5b",
      "name": "Improve session auto-detection",
      "description": "Currently tukan auto-detects a single session based on the active tmux session, which can silently target the wrong board. Improve auto-detection so tukan commands act across all relevant sessions where appropriate — e.g. 'tukan list' could show cards from all sessions, and ambiguous commands could prompt or aggregate instead of silently picking one.",
      "acceptanceCriteria": "Commands without -s behave sensibly across multiple sessions; no more silent wrong-session targeting",
      "columnId": "4",
      "sessionName": "tukan",
      "dir": "/Users/jordan/devel/personal/tukan",
      "command": "claude",
      "worktree": false,
      "createdAt": 1771309136212,
      "startedAt": 1771480239319,
      "closedAt": 1771481248794
    },
    "1f57e80a-a2d8-4c19-956c-c6756250ff5f": {
      "id": "1f57e80a-a2d8-4c19-956c-c6756250ff5f",
      "name": "Add 'tukan show <id>' command",
      "description": "Add a CLI subcommand 'tukan show <id>' that prints details for a specific card by ID. Currently 'tukan show' with no ID launches the TUI (which requires raw mode/TTY), so there is no non-TTY way to inspect a single card. This command should print name, description, acceptance criteria, column, dir, and other metadata — ideally also respecting a --json flag.",
      "acceptanceCriteria": "'tukan show <id>' prints card details without requiring a TTY; works in scripts and non-interactive contexts",
      "columnId": "4",
      "sessionName": "tukan",
      "dir": "/Users/jordan/devel/personal/tukan",
      "command": "shell",
      "worktree": false,
      "createdAt": 1771309900546,
      "startedAt": 1771469069650,
      "closedAt": 1771469521367
    },
    "5547890e-402e-44de-b770-8856c222cab7": {
      "id": "5547890e-402e-44de-b770-8856c222cab7",
      "columnId": "4",
      "name": "Scrolling title",
