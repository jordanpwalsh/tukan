    "47f7122d-79ed-4cf9-b39c-c9ae970468e1": {
      "id": "47f7122d-79ed-4cf9-b39c-c9ae970468e1",
      "name": "Add --wait flag to tukan start",
      "description": "Add a --wait flag to 'tukan start' that blocks after starting the card and continuously streams pane state changes to stdout. This lets an orchestrator (e.g. an AI agent) run 'tukan start <id> --wait' and react to output in real-time — detecting when the card needs input (permission prompts, plan approval) or completes — without polling on a fixed interval.",
      "acceptanceCriteria": "--wait blocks and streams pane diffs/events until the card's window closes; orchestrators can pipe or watch this output to react immediately",
      "columnId": "4",
      "sessionName": "tukan",
      "dir": "/Users/jordan/devel/personal/tukan",
      "command": "claude",
      "worktree": false,
      "createdAt": 1771469274573,
      "startedAt": 1771479499282,
      "closedAt": 1771479905143
    },
    "d5a23268-485f-4fc7-b9d9-c5528d9e8336": {
      "id": "d5a23268-485f-4fc7-b9d9-c5528d9e8336",
      "name": "Web UI with browser-based tmux terminal access",
      "description": "Build a web UI for Tukan that lets you view and manage the kanban board from a browser. Key feature: browser-based terminal access to each card's tmux window (like ttyd or xterm.js), so you can see live output and interact with running cards without switching to the terminal. Should include the board view (columns/cards) and the ability to open a card's terminal in-browser.",
      "acceptanceCriteria": "Browser shows kanban board; clicking a card opens a live terminal connected to its tmux pane; works locally",
      "columnId": "1",
      "sessionName": "tukan",
      "dir": "/Users/jordan/devel/personal/tukan",
      "command": "claude",
      "worktree": false,
      "createdAt": 1771476924426
    },
    "783576c4-fa64-4f3c-bfee-f36cb79c46cf": {
      "id": "783576c4-fa64-4f3c-bfee-f36cb79c46cf",
      "columnId": "4",
      "name": "Session Level Hooks",
      "description": "Session level hooks - before and after type things, like commit and push and build.",
      "acceptanceCriteria": "",
      "sessionName": "tukan",
      "dir": "/Users/jordan/devel/personal/tukan",
      "command": "claude",
      "worktree": false,
      "createdAt": 1771480948822,
